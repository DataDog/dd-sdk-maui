<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-android;net10.0-ios</TargetFrameworks>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Datadog.Maui</RootNamespace>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Package metadata -->
    <PackageId>Datadog.Maui</PackageId>
    <Title>Datadog MAUI SDK</Title>
    <Description>Datadog SDK for .NET MAUI applications - monitoring, logging, and RUM</Description>
    <Authors>Datadog</Authors>
    <Copyright>Copyright (c) Datadog 2024</Copyright>
    <PackageTags>datadog;maui;monitoring;logging;rum;apm;observability</PackageTags>

    <!-- Supported OS versions -->
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">12.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">26</SupportedOSPlatformVersion>

    <!-- Java SDK for Android builds (Android Studio bundled JBR) -->
    <JavaSdkDirectory Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">/Applications/Android Studio.app/Contents/jbr/Contents/Home</JavaSdkDirectory>
  </PropertyGroup>

  <!-- MAUI Controls dependency -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
  </ItemGroup>

  <!-- Android-specific dependencies -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <!-- Kotlin required by Datadog SDK -->
    <PackageReference Include="Xamarin.Kotlin.StdLib.Jdk8" Version="2.0.21" />
    <!-- AndroidX Work Manager required by Datadog SDK -->
    <PackageReference Include="Xamarin.AndroidX.Work.Runtime" Version="2.8.1" />
  </ItemGroup>

  <!-- Android native Gradle project binding -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <AndroidGradleProject Include="..\..\native\android\build.gradle.kts">
      <ModuleName>datadogwrapper</ModuleName>
      <Configuration>Release</Configuration>
      <Bind>true</Bind>
    </AndroidGradleProject>
  </ItemGroup>

  <!-- iOS-specific configuration -->
  <PropertyGroup Condition="$(TargetFramework.Contains('ios'))">
    <!-- ObjC linker flag required for native binding interop -->
    <MtouchExtraArgs>-gcc_flags "-ObjC"</MtouchExtraArgs>
  </PropertyGroup>

  <!-- iOS native static library reference -->
  <!-- Note: Built from Swift package via:
       xcodebuild -scheme DatadogWrapper -destination 'generic/platform=iOS Simulator' -configuration Release BUILD_LIBRARY_FOR_DISTRIBUTION=YES
       libtool -static -o libDatadogWrapper.a DatadogWrapper.o DatadogCore.o DatadogInternal.o DatadogPrivate.o
  -->
  <ItemGroup Condition="$(TargetFramework.Contains('ios'))">
    <NativeReference Include="..\..\native\ios\lib\iphonesimulator\libDatadogWrapper.a">
      <Kind>Static</Kind>
      <SmartLink>False</SmartLink>
      <ForceLoad>True</ForceLoad>
    </NativeReference>
  </ItemGroup>

</Project>
