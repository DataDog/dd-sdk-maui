<!--
  DatadogSdk.Android.Binding.targets
  Automatically loaded by MSBuild for any project that references this NuGet package
  (placed under buildTransitive/, so it also applies to transitive consumers).

  Injects the merged Datadog ProGuard rules into the consuming app's R8 step,
  ensuring Datadog wrapper and SDK classes are retained in Release builds.
-->
<Project>
  <ItemGroup Condition="$(TargetFramework.Contains('-android'))">
    <ProguardConfiguration Include="$(MSBuildThisFileDirectory)proguard\datadog-merged.pro" />
  </ItemGroup>
</Project>
