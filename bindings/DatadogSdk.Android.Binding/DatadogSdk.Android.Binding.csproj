<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Use class-parse for Kotlin support -->
    <AndroidClassParser>class-parse</AndroidClassParser>
    <!-- Suppress XA4241/XA4242: Java transitive deps are satisfied via NuGet; verification not needed -->
    <NoWarn>$(NoWarn);XA4241;XA4242</NoWarn>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- AAR from Kotlin wrapper -->
    <AndroidLibrary Include="Jars\datadogwrapper-release.aar" />

    <!-- Metadata transformations -->
    <TransformFile Include="Transforms\Metadata.xml" />

    <!-- ProGuard rules applied when building this library -->
    <ProguardConfiguration Include="Transforms\proguard.txt" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Pack the .targets file and merged ProGuard rules into the NuGet package
      under buildTransitive/ so MSBuild auto-loads them for any project that
      references this package (directly or transitively).
      The .targets file adds a <ProguardConfiguration> item pointing to the
      merged rules, ensuring R8 retains Datadog classes in Release builds.
    -->
    <None Include="build\DatadogSdk.Android.Binding.targets"
          Pack="true"
          PackagePath="buildTransitive\net10.0-android\" />
    <None Include="proguard\datadog-merged.pro"
          Pack="true"
          PackagePath="buildTransitive\net10.0-android\proguard\" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reference dd-sdk-android binding packages -->
    <PackageReference Include="DatadogSdk.Android.Logs" Version="0.1.0" />

    <!-- Required for Kotlin-based libraries -->
    <PackageReference Include="Xamarin.Kotlin.StdLib" Version="2.2.0.1" />
  </ItemGroup>
</Project>
