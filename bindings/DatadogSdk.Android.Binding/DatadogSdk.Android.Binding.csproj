<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Use class-parse for Kotlin support -->
    <AndroidClassParser>class-parse</AndroidClassParser>
    <!-- Suppress XA4241/XA4242: Java transitive deps are satisfied via NuGet; verification not needed -->
    <NoWarn>$(NoWarn);XA4241;XA4242</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- AAR from Kotlin wrapper -->
    <AndroidLibrary Include="Jars\datadogwrapper-release.aar" />

    <!-- Metadata transformations -->
    <TransformFile Include="Transforms\Metadata.xml" />

    <!-- ProGuard rules - CRITICAL for R8 -->
    <ProguardConfiguration Include="Transforms\proguard.txt" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reference dd-sdk-android binding packages -->
    <PackageReference Include="DatadogSdk.Android.Logs" Version="1.0.0" />

    <!-- Required for Kotlin-based libraries -->
    <PackageReference Include="Xamarin.Kotlin.StdLib" Version="2.2.0.1" />
  </ItemGroup>
</Project>
