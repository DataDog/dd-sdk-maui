<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\StripTransitiveJni.targets" />

  <!-- tools/DebugIdManifestGenerator is its own standalone console app project — exclude its
       sources from this library's implicit **/*.cs glob so they don't get compiled straight
       into Datadog.Maui itself (its Program.cs uses top-level statements, which only compile in
       an Exe output type, so left in this would break every build of this library). -->
  <ItemGroup>
    <Compile Remove="tools\**\*.cs" />
    <None Remove="tools\**" />
    <Compile Remove="build\tools\**\*.cs" />
    <None Remove="build\tools\**" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFrameworks>net9.0-ios;net9.0-android;net10.0-ios;net10.0-android</TargetFrameworks>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">23.0</SupportedOSPlatformVersion>
    <RootNamespace>Datadog.Maui</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Package metadata -->
    <PackageId>Datadog.Maui</PackageId>
    <Version>0.2.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Authors>Datadog</Authors>
    <Company>Datadog</Company>
    <Description>Datadog SDK bindings for .NET MAUI applications. Provides logging, RUM, and APM capabilities for iOS and Android.</Description>
    <PackageProjectUrl>https://github.com/DataDog/dd-sdk-maui</PackageProjectUrl>
    <RepositoryUrl>https://github.com/DataDog/dd-sdk-maui</RepositoryUrl>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageTags>datadog;maui;logging;monitoring;rum;apm;ios;android</PackageTags>
  </PropertyGroup>

  <!-- Pack the .targets files into the NuGet package so consuming apps get them automatically -->
  <ItemGroup>
    <None Include="build\Datadog.Maui.targets"
          Pack="true"
          PackagePath="buildTransitive\Datadog.Maui.targets" />
    <None Include="build\Datadog.Maui.DebugId.targets"
          Pack="true"
          PackagePath="buildTransitive\Datadog.Maui.DebugId.targets" />
  </ItemGroup>

  <!-- Build the debug-id manifest generator tool (see tools/DebugIdManifestGenerator) once per
       outer build/pack invocation — not once per TargetFramework — and pack its published
       output alongside the .targets file that invokes it via `dotnet exec`. -->
  <Target Name="_DdBuildDebugIdManifestGenerator"
          BeforeTargets="Build;Pack"
          Condition="'$(TargetFramework)' == ''">
    <Exec Command="dotnet publish &quot;$(MSBuildThisFileDirectory)tools\DebugIdManifestGenerator\DebugIdManifestGenerator.csproj&quot; -c Release -o &quot;$(MSBuildThisFileDirectory)build\tools\DebugIdManifestGenerator&quot;" />
  </Target>

  <ItemGroup>
    <None Include="build\tools\DebugIdManifestGenerator\DebugIdManifestGenerator.dll"
          Pack="true"
          PackagePath="buildTransitive\tools\DebugIdManifestGenerator\DebugIdManifestGenerator.dll" />
    <None Include="build\tools\DebugIdManifestGenerator\DebugIdManifestGenerator.runtimeconfig.json"
          Pack="true"
          PackagePath="buildTransitive\tools\DebugIdManifestGenerator\DebugIdManifestGenerator.runtimeconfig.json" />
  </ItemGroup>

  <!-- MAUI Controls (provides Page, VisualElement, etc. for auto-tracking predicates) -->
  <ItemGroup Condition="$(TargetFramework.StartsWith('net9.0'))">
    <PackageReference Include="Microsoft.Maui.Controls" Version="9.0.0" />
  </ItemGroup>
  <ItemGroup Condition="$(TargetFramework.StartsWith('net10.0'))">
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.0" />
  </ItemGroup>

  <!-- iOS platform dependencies -->
  <ItemGroup Condition="$(TargetFramework.Contains('-ios'))">
    <PackageReference Include="Datadog.iOS.Binding" Version="0.2.0" />
  </ItemGroup>

  <!-- Android platform dependencies -->
  <ItemGroup Condition="$(TargetFramework.Contains('-android'))">
    <PackageReference Include="Datadog.Android.Binding" Version="0.2.0" />
    <!-- Runtime dependencies for Android -->
    <PackageReference Include="Xamarin.Kotlin.StdLib" Version="2.2.0.1" />
    <PackageReference Include="Xamarin.Kotlin.Reflect" Version="2.2.0.1" />
    <PackageReference Include="Square.OkHttp3" Version="4.12.0" />
    <PackageReference Include="GoogleGson" Version="2.13.1.1" />
    <PackageReference Include="Xamarin.AndroidX.Annotation" Version="1.9.1.5" />
    <PackageReference Include="Xamarin.AndroidX.Collection" Version="1.5.0.3" />
    <PackageReference Include="Xamarin.AndroidX.Collection.Ktx" Version="1.5.0.3" />
    <PackageReference Include="Xamarin.AndroidX.Work.Runtime" Version="2.8.1" />
    <PackageReference Include="Square.OkIO" Version="3.6.0" />
  </ItemGroup>
</Project>
