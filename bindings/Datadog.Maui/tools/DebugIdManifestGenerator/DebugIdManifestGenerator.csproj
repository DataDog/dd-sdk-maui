<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Runs via `dotnet exec` at consuming-app build time, on whatever .NET runtime that
         machine has installed — RollForward avoids hardcoding a specific SDK/runtime version. -->
    <RollForward>LatestMajor</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Datadog.Maui.Tools.DebugIdManifestGenerator</RootNamespace>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DebugIdManifestGenerator.Tests" />
  </ItemGroup>

</Project>
