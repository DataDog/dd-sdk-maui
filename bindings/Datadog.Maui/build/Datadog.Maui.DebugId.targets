<!--
  Datadog.Maui.DebugId.targets
  Generates a build-time manifest mapping each referenced assembly's simple name to its PE
  debug-directory id (CodeView GUID + Stamp), and packages it into the app so it can be read
  back at runtime to correlate a stack-trace frame with the Portable PDB uploaded for that
  assembly.

  This replaces an earlier runtime-only design (reading Assembly.Location off the live loaded
  assembly) that was confirmed broken on real device builds: packaged Android/iOS apps never
  expose their assemblies as standalone files on disk, so Assembly.Location is empty there and
  that lookup silently failed for every real app. See the RUM-18288 Jira comment "Correction to
  the runtime-resolution mechanism in the decision above" for the full writeup and the
  empirical verification matrix (Android Debug/Release-R8, iOS Debug/Release-simulator).

  The manifest itself is generated by a small precompiled tool (tools/DebugIdManifestGenerator)
  rather than an inline RoslynCodeTaskFactory task — the prototype hit persistent
  reference-resolution failures (CS0012/CS0518) trying to reference System.Reflection.Metadata
  from inline task code, and any fix required hardcoding a specific .NET runtime version, which
  isn't safe across consumers' machines.

  The manifest is written by up to three distinct targets (NOT the same target hooked
  twice — MSBuild only executes a given target once per project build, however many
  things depend on or come after it, so hooking one target from two trigger points
  silently collapses to a single run):
    1. _DdStubDebugIdManifest, forced early by _DdRegisterDebugIdManifestAsset's
       DependsOnTargets, before Compile/CoreCompile has run (MAUI's ProcessMauiAssets —
       which needs the MauiAsset item declared — itself runs before Compile on both
       platforms). It writes a placeholder file, just so one exists. This exists only
       because iOS is stricter than Android: iOS validates that every declared bundle
       resource physically exists on disk very early in the build (Xamarin.Shared.targets'
       bundle-resource check), well before Compile — with no file at all there, the build
       fails outright ("Bundle Resource ... not found on disk"). Android has no
       equivalent eager check, but running this early there too is harmless.
    2. _DdGenerateDebugIdManifest writes the first complete manifest, from the app's own
       assembly as it exists right after CoreCompile plus every @(ReferencePath). This is
       CORRECT when nothing rewrites assemblies afterwards (Android Debug, iOS simulator
       Debug), but WRONG whenever the linker runs as part of the build (`dotnet build`, not
       just publish) and rewrites assemblies: iOS device builds (the managed static
       registrar, run inside the linker, rewrites the app's own assembly and others with a
       new CodeView GUID), iOS IL stripping (re-stamps every shipped assembly), and Android
       Release trimming (rewrites trimmed library assemblies and drops their CodeView entry).
       The first-pass ids would then describe assemblies the app doesn't actually ship.
    3. _DdRewriteDebugIdManifestPostLink (Android) / _DdRewriteDebugIdManifestPostLink_iOS
       (iOS) regenerate the manifest a second time, from scratch, from the assemblies the
       app actually ships once linking/stripping has finished — so an assembly that lost its
       CodeView entry gets no manifest line at all rather than keeping its stale first-pass
       id (RUM-18989). See each target's own comment for why the two platforms need
       different final hooks.
-->
<Project>

  <PropertyGroup>
    <_DdDebugIdManifestGeneratorDll>$(MSBuildThisFileDirectory)tools/DebugIdManifestGenerator/DebugIdManifestGenerator.dll</_DdDebugIdManifestGeneratorDll>
  </PropertyGroup>

  <!-- Placeholder so a file exists before iOS's eager bundle-resource check — see the
       file header. Its content is irrelevant; _DdGenerateDebugIdManifest overwrites it. -->
  <Target Name="_DdStubDebugIdManifest"
          Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' Or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">

    <PropertyGroup>
      <_DdDebugIdManifestPath>$(IntermediateOutputPath)dd_debug_ids.json</_DdDebugIdManifestPath>
    </PropertyGroup>

    <WriteLinesToFile File="$(_DdDebugIdManifestPath)" Lines="{}" Overwrite="true" Condition="!Exists('$(_DdDebugIdManifestPath)')" />
  </Target>

  <!-- Generate the manifest's real contents, after the project's own assembly has been
       compiled — see the file header. -->
  <Target Name="_DdGenerateDebugIdManifest"
          AfterTargets="CoreCompile"
          Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' Or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">

    <!-- $(IntermediateOutputPath) must be read here, inside the target, not in a
         file-scope PropertyGroup above — at file-scope it evaluates before the SDK
         has set it (for some project-evaluation passes), silently resolving to a
         bare filename and writing the manifest into the working directory instead
         of obj/. -->
    <PropertyGroup>
      <_DdDebugIdManifestPath>$(IntermediateOutputPath)dd_debug_ids.json</_DdDebugIdManifestPath>
    </PropertyGroup>

    <!-- The app's own assembly: right after CoreCompile, the freshly compiled DLL sits at
         $(IntermediateOutputPath)$(TargetFileName) (obj/) — $(TargetPath) (bin/) isn't
         populated until a later copy-to-output step runs, so reading $(TargetPath) here
         would silently (BuildManifest just skips missing files) drop the app's own
         assembly from the manifest on a clean build. -->
    <ItemGroup>
      <_DdDebugIdManifestAssemblies Include="@(ReferencePath)" />
      <_DdDebugIdManifestAssemblies Include="$(IntermediateOutputPath)$(TargetFileName)" />
    </ItemGroup>

    <Message Importance="low" Text="Datadog: generating debug-id manifest at $(_DdDebugIdManifestPath)" />

    <!-- A MAUI app's framework + package references can push the expanded path list past
         cmd.exe's ~8,191-character command-line limit on Windows. Write the paths to a
         response file instead of putting them directly on the command line — the generator
         reads a single "@<file>" argument the same way MSBuild/csc response files work. -->
    <PropertyGroup>
      <_DdDebugIdManifestAssembliesFile>$(IntermediateOutputPath)dd_debug_ids.assemblies.rsp</_DdDebugIdManifestAssembliesFile>
    </PropertyGroup>

    <WriteLinesToFile File="$(_DdDebugIdManifestAssembliesFile)" Lines="@(_DdDebugIdManifestAssemblies->'%(FullPath)')" Overwrite="true" />

    <Exec Command="dotnet exec &quot;$(_DdDebugIdManifestGeneratorDll)&quot; &quot;$(_DdDebugIdManifestPath)&quot; &quot;@$(_DdDebugIdManifestAssembliesFile)&quot;" />
  </Target>

  <!-- Glob patterns for the linker (ILLink) output folders of the RIDs this build targets,
       used by _DdRewriteDebugIdManifestPostLink (assemblies) and Datadog.Maui.targets'
       DatadogUploadPortablePdb (PDBs). With a single RuntimeIdentifier (iOS, or Android built
       with -r) $(IntermediateOutputPath) already includes the RID, and the linking build uses
       that same path (it gets the same RuntimeIdentifier), so the folder is
       $(IntermediateOutputPath)linked/. With several Android ABIs (the default,
       $(RuntimeIdentifiers)), each RID links in its own $(IntermediateOutputPath)<rid>/linked/.
       Listing the targeted RIDs explicitly, instead of a <rid> wildcard, keeps folders left
       over from an earlier build with a different ABI set out of the build. (The linker
       doesn't delete files it no longer writes, so a targeted folder can still hold an
       assembly from an earlier build that this build doesn't ship; its manifest line is
       harmless because no frame comes from it.)

       Only the Android manifest pass also requires PublishTrimmed=true. The upload must not:
       iOS sets PublishTrimmed only in RID-specific builds, so it can be empty where the
       upload runs, and a stale linked PDB can't be staged anyway — staging requires its GUID
       to match the current manifest. -->
  <Target Name="_DdComputeLinkedDirectories">
    <ItemGroup>
      <_DdTargetedRid Include="$(RuntimeIdentifiers)" Condition="'$(RuntimeIdentifier)' == ''" />
    </ItemGroup>

    <PropertyGroup>
      <_DdLinkedAssemblyGlobs Condition="'$(RuntimeIdentifier)' != ''">$(IntermediateOutputPath)linked\*.dll</_DdLinkedAssemblyGlobs>
      <_DdLinkedAssemblyGlobs Condition="'$(RuntimeIdentifier)' == ''">@(_DdTargetedRid->'$(IntermediateOutputPath)%(Identity)\linked\*.dll')</_DdLinkedAssemblyGlobs>
      <_DdLinkedPdbGlobs Condition="'$(RuntimeIdentifier)' != ''">$(IntermediateOutputPath)linked\*.pdb</_DdLinkedPdbGlobs>
      <_DdLinkedPdbGlobs Condition="'$(RuntimeIdentifier)' == ''">@(_DdTargetedRid->'$(IntermediateOutputPath)%(Identity)\linked\*.pdb')</_DdLinkedPdbGlobs>
    </PropertyGroup>
  </Target>

  <!-- Android: regenerate the manifest from the assemblies the APK actually ships, once the
       linker (ILLink) has run. In Release builds every shipped assembly — the app's own and
       every reference — goes through ILLink, which writes them all to
       $(IntermediateLinkDir) = $(IntermediateOutputPath)<rid>/linked/ (the shared trimmer,
       microsoft.net.illink.tasks' Microsoft.NET.ILLink.targets, computes ManagedAssemblyToLink
       from @(ResolvedFileToPublish)). With Android's default partial trimming the app's own
       assembly is copied there unchanged (same CodeView id as the compiler output), while
       trimmed library assemblies are rewritten with NO CodeView entry at all: Android's
       _PrepareLinking sets TrimmerRemoveSymbols=true unless AndroidIncludeDebugSymbols is
       true, and Xamarin.Android.Common.targets resets AndroidIncludeDebugSymbols to False for
       every optimized build that embeds assemblies in the APK (i.e. Release), whatever the
       project sets.

       Read linked/, not linked/shrunk/: shrunk/ is a later copy made by
       _RemoveRegisterAttribute, which runs well after this target (and is skipped entirely
       when AndroidIncludeDebugSymbols=true), so a shrunk/ glob matched nothing here and this
       rewrite silently did nothing (RUM-18989). Confirmed from a binlog: _RunILLink →
       this target → _GenerateAndroidAssetsDir/_CreateBaseApk → (later) _RemoveRegisterAttribute.
       The two folders hold the same assemblies; the only one _RemoveRegisterAttribute changes
       is Mono.Android, which has no CodeView entry either way.

       Only the linked/ folders of the RIDs THIS build targets are read (see
       _DdComputeLinkedDirectories), and only when this build trims: a linked/ folder left
       over from an earlier build — with a different ABI set, or before trimming was turned
       off — holds assemblies this APK doesn't ship, and their ids could otherwise end up in
       the manifest and resolve frames against a PDB uploaded back then. The APK carries one
       manifest for all ABIs and the generator keeps the last entry on a duplicate name;
       builds for multiple ABIs were confirmed to produce identical linked output.

       BeforeTargets="_GenerateAndroidAssetsDir", NOT BeforeTargets="UpdateAndroidAssets" —
       confirmed empirically via -v:diag that the actual file-copy from
       $(IntermediateOutputPath)dd_debug_ids.json into the obj/.../assets/ staging dir (which
       the final .apk is later built from) happens inside _GenerateAndroidAssetsDir, which is
       a DependsOnTargets dependency of UpdateAndroidAssets — dependencies run before a
       target's own BeforeTargets insertions do, so hooking UpdateAndroidAssets itself is one
       step too late; the copy has already run by then.

       On Debug builds (no trimming) no linked/ folder is read and this falls back to the same
       inputs _DdGenerateDebugIdManifest already used, so this target is a harmless re-run
       there, not a special case to guard against. -->
  <Target Name="_DdRewriteDebugIdManifestPostLink"
          BeforeTargets="_GenerateAndroidAssetsDir"
          DependsOnTargets="_DdComputeLinkedDirectories"
          Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">

    <PropertyGroup>
      <_DdDebugIdManifestPath>$(IntermediateOutputPath)dd_debug_ids.json</_DdDebugIdManifestPath>
    </PropertyGroup>

    <ItemGroup>
      <_DdLinkedAssemblies Include="$(_DdLinkedAssemblyGlobs)" Condition="'$(PublishTrimmed)' == 'true'" />
    </ItemGroup>

    <!-- Start from an empty list instead of adding to the one _DdGenerateDebugIdManifest
         built (items persist across targets within a build). When linking ran, the manifest
         must describe ONLY the linked assemblies: an assembly the linker rewrote without a
         CodeView entry is skipped by the generator, and must not fall back to its pre-link
         @(ReferencePath) id — that id belongs to the unmodified assembly (shipped as-is by
         Debug builds), so a PDB uploaded for it would resolve this build's rewritten
         assembly to wrong lines (RUM-18989). Leaving it out means its frames carry no
         assembly_id and stay unsymbolicated instead. -->
    <ItemGroup>
      <_DdDebugIdManifestAssemblies Remove="@(_DdDebugIdManifestAssemblies)" />
      <_DdDebugIdManifestAssemblies Include="@(ReferencePath)" Condition="'@(_DdLinkedAssemblies)' == ''" />
      <_DdDebugIdManifestAssemblies Include="$(IntermediateOutputPath)$(TargetFileName)" Condition="'@(_DdLinkedAssemblies)' == ''" />
      <_DdDebugIdManifestAssemblies Include="@(_DdLinkedAssemblies)" Condition="'@(_DdLinkedAssemblies)' != ''" />
    </ItemGroup>

    <Message Importance="low" Text="Datadog: rewriting debug-id manifest from post-link assemblies at $(_DdDebugIdManifestPath)" />

    <!-- Own .rsp filename per target (not shared with _DdGenerateDebugIdManifest /
         _DdRewriteDebugIdManifestPostLink_iOS) — harmless today since only one platform's
         targets ever run in a given build and each target writes-then-reads its file within
         the same synchronous target body, but a shared literal name is a needless trap for
         whoever next touches target scheduling here. -->
    <PropertyGroup>
      <_DdDebugIdManifestAssembliesFile>$(IntermediateOutputPath)dd_debug_ids.assemblies.postlink.rsp</_DdDebugIdManifestAssembliesFile>
    </PropertyGroup>

    <WriteLinesToFile File="$(_DdDebugIdManifestAssembliesFile)" Lines="@(_DdDebugIdManifestAssemblies->'%(FullPath)')" Overwrite="true" />

    <Exec Command="dotnet exec &quot;$(_DdDebugIdManifestGeneratorDll)&quot; &quot;$(_DdDebugIdManifestPath)&quot; &quot;@$(_DdDebugIdManifestAssembliesFile)&quot;" />
  </Target>

  <!-- iOS: regenerate the manifest from whatever the SDK's own publish pipeline actually
       ships, AND push it directly into the already-built .app bundle.

       First cut of this target read $(IntermediateOutputPath)linked\$(TargetFileName) —
       WRONG, found via independent review: on the standard Release+AOT+single-RID config
       (EnableAssemblyILStripping defaults to true there — see _ComputeStripAssemblyIL in
       the iOS SDK's Xamarin.Shared.Sdk.targets), a further target _StripAssemblyIL runs
       AFTER _LoadLinkerOutput and re-emits EVERY published assembly (not just the app's
       own — anything in @(ResolvedFileToPublish) with a .dll extension) into
       $(DeviceSpecificIntermediateOutputPath)stripped, each with a fresh CodeView Stamp
       (the GUID is kept — only the stamp changes, to the build time — so the linker's PDB
       still matches the stripped assembly by GUID), and that stripped copy — not linked/ —
       is what _StripAssemblyIL itself swaps into @(ResolvedFileToPublish) and what later
       gets copied into the .app. So reading linked/ shipped a stale id (wrong stamp) for
       every stripped assembly, not only the app's own. Reading @(ResolvedFileToPublish) instead of guessing a path directly
       tracks whatever _StripAssemblyIL (if it ran) already substituted, so this is
       correct whether or not stripping happened, without needing our own condition on
       $(EnableAssemblyILStripping) — a target's Condition failing doesn't remove its
       AfterTargets scheduling point, only its body, so hooking AfterTargets="_StripAssemblyIL"
       still runs at the right point on Debug builds where stripping is skipped.

       IMPORTANT, confirmed via -v:diag: AfterTargets does NOT mean "after every target in
       this semicolon-list has run" — MSBuild inserts the hooked target at the FIRST point
       in the build graph where any listed name is reached, even if that's an earlier,
       unrelated dependency-chain reference to the same name rather than its real, later
       execution. A first attempt listing "_StripAssemblyIL;_LoadLinkerOutput" together
       got inserted right after _LoadLinkerOutput's DependsOnTargets chain — which runs much
       earlier, well before the real _StripAssemblyIL target body executes — reproducing
       the exact same class of ordering bug found on Android. Anchoring on _StripAssemblyIL
       alone avoids this because nothing else references that name earlier in the graph.

       We still need to push directly into $(AppBundleDir): iOS's real bundle-resource
       copy (_CopyResourcesToBundle, which is what actually copies our MauiAsset's
       on-disk bytes into the .app) was confirmed empirically to run BEFORE stripping or
       linking even start — so by the time either finishes, our file has already been
       copied into the bundle once, with stale content, and nothing will copy it again
       automatically. Rewriting $(IntermediateOutputPath)'s copy alone (as the Android
       target above does) would be silently correct-but-unshipped: the file sitting in
       bin/.../example.app would still hold the old value. $(AppBundleDir) is a plain
       MSBuild property, confirmed set well before this point in the build and stable
       for its remainder. -->
  <Target Name="_DdRewriteDebugIdManifestPostLink_iOS"
          AfterTargets="_StripAssemblyIL"
          Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' And '@(ResolvedFileToPublish)' != ''">

    <PropertyGroup>
      <_DdDebugIdManifestPath>$(IntermediateOutputPath)dd_debug_ids.json</_DdDebugIdManifestPath>
      <_DdAppBundleManifestPath>$(AppBundleDir)/dd_debug_ids.json</_DdAppBundleManifestPath>
    </PropertyGroup>

    <!-- Start from an empty list instead of adding to the one _DdGenerateDebugIdManifest
         built (items persist across targets within a build), so the manifest lists exactly
         the assemblies the .app ships. Otherwise an assembly the linker rewrote without a
         CodeView entry (it had no PDB to start from, e.g. Datadog.Maui from its NuGet
         package) is skipped by the generator here, and its stale pre-link @(ReferencePath)
         id survives from the first pass — an id that describes the unmodified assembly, not
         the rewritten one this .app ships (RUM-18989). It also drops entries for referenced
         assemblies that aren't shipped at all. -->
    <ItemGroup>
      <_DdDebugIdManifestAssemblies Remove="@(_DdDebugIdManifestAssemblies)" />
      <_DdDebugIdManifestAssemblies Include="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.dll' And '%(ResolvedFileToPublish.Culture)' == ''" />
    </ItemGroup>

    <Message Importance="low" Text="Datadog: rewriting debug-id manifest from @(ResolvedFileToPublish) (post-strip if stripping ran) at $(_DdDebugIdManifestPath), re-copying into $(_DdAppBundleManifestPath)" />

    <PropertyGroup>
      <_DdDebugIdManifestAssembliesFile>$(IntermediateOutputPath)dd_debug_ids.assemblies.ios.rsp</_DdDebugIdManifestAssembliesFile>
    </PropertyGroup>

    <WriteLinesToFile File="$(_DdDebugIdManifestAssembliesFile)" Lines="@(_DdDebugIdManifestAssemblies->'%(FullPath)')" Overwrite="true" />

    <Exec Command="dotnet exec &quot;$(_DdDebugIdManifestGeneratorDll)&quot; &quot;$(_DdDebugIdManifestPath)&quot; &quot;@$(_DdDebugIdManifestAssembliesFile)&quot;" />

    <Copy SourceFiles="$(_DdDebugIdManifestPath)" DestinationFiles="$(_DdAppBundleManifestPath)" Condition="Exists('$(AppBundleDir)')" />
  </Target>

  <!-- ═══════════════════════════════════════════════════════════════════════
       Declare the manifest as a MauiAsset so it ships inside the app and is
       readable at runtime via FileSystem.Current.OpenAppPackageFileAsync.
       ═══════════════════════════════════════════════════════════════════════ -->
  <Target Name="_DdRegisterDebugIdManifestAsset"
          DependsOnTargets="_DdStubDebugIdManifest"
          BeforeTargets="ProcessMauiAssets"
          Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' Or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">

    <PropertyGroup>
      <_DdDebugIdManifestPath>$(IntermediateOutputPath)dd_debug_ids.json</_DdDebugIdManifestPath>
    </PropertyGroup>

    <ItemGroup>
      <MauiAsset Include="$(_DdDebugIdManifestPath)" LogicalName="dd_debug_ids.json" />
    </ItemGroup>
  </Target>

</Project>
