<!--
  Datadog.Maui.targets
  Automatically loaded by MSBuild for any project that references the Datadog.Maui
  NuGet package (placed under buildTransitive/, so it applies to transitive consumers).

  Provides a post-publish target that uploads debug symbols to Datadog for crash
  symbolication and error tracking.

  Prerequisites:
    npm install -g @datadog/datadog-ci

  Usage:
    Set these properties in your .csproj or via command line:

    <DatadogUploadSymbols>true</DatadogUploadSymbols>
    <DatadogSite>datadoghq.com</DatadogSite>          (optional; unset means datadog-ci's own
                                                       DATADOG_SITE/DD_SITE handling applies)
    <DatadogServiceName>your-service</DatadogServiceName>  (optional, defaults to assembly name)
    <DatadogKeepPortablePdbs>true</DatadogKeepPortablePdbs>  (optional, defaults to false — see below)
    <DatadogFailOnSymbolUploadError>false</DatadogFailOnSymbolUploadError>  (optional, defaults to false)

    Or pass them on the command line:
      export DATADOG_API_KEY=xxx
      dotnet publish -c Release -p:DatadogUploadSymbols=true

    For a non-default org/site, `export DATADOG_SITE=datad0g.com` is enough.
    -p:DatadogSite=… pins a site explicitly and overrides the environment.

    Upload failures are reported in the summary and as an MSBuild warning, but do not
    fail the build. -p:DatadogFailOnSymbolUploadError=true makes them errors.

  What gets uploaded:
    iOS:     .dSYM bundle (covers native + AOT-compiled C# crashes)
    Android: ProGuard/R8 mapping.txt (covers obfuscated Java/Kotlin names)
    Both:    Portable PDB (covers managed C# stack traces, first-party assemblies only)

  Note: the Portable PDB upload correlates by the build-time debug-id manifest
  (RUM-18332, see Datadog.Maui.DebugId.targets) rather than re-deriving the id
  at upload time, so it stays correct across IL trimming/AOT stripping. For each
  assembly it uploads the PDB whose id matches the shipped assembly — on iOS device
  builds that's the linker's PDB under obj/…/linked/, not the bin/ copy (RUM-18989).

  iOS Portable PDB bundle stripping:
    Symbolication of managed (C#) exceptions is always done offline, backend-side,
    from the Portable PDB uploaded above — the app never needs to read its own PDB
    on-device. On iOS, some opt-in debug configurations (e.g. `soft-debug`) cause
    the build to also bundle the Portable PDB inside the shipped .app, which serves
    no purpose for this SDK and only adds size. When DatadogUploadSymbols=true,
    this target strips any Portable PDB from the published iOS app bundle by
    default. Set DatadogKeepPortablePdbs=true to keep it in the bundle instead
    (e.g. if you rely on it for your own on-device debugging).
-->
<Project>

  <!-- Build-time assembly debug-id manifest generation (RUM-18332) — see
       Datadog.Maui.DebugId.targets for details. -->
  <Import Project="Datadog.Maui.DebugId.targets" />

  <!-- Defaults -->
  <PropertyGroup>
    <DatadogUploadSymbols Condition="'$(DatadogUploadSymbols)' == ''">false</DatadogUploadSymbols>

    <!-- DatadogSite has no default on purpose: it is injected into datadog-ci's
         environment below, so any default here would override an exported
         DATADOG_SITE. Left unset, datadog-ci resolves the site itself. -->
    <DatadogServiceName Condition="'$(DatadogServiceName)' == ''">$(AssemblyName)</DatadogServiceName>
    <DatadogKeepPortablePdbs Condition="'$(DatadogKeepPortablePdbs)' == ''">false</DatadogKeepPortablePdbs>

    <DatadogFailOnSymbolUploadError Condition="'$(DatadogFailOnSymbolUploadError)' == ''">false</DatadogFailOnSymbolUploadError>

    <_DdCanUpload>false</_DdCanUpload>
  </PropertyGroup>

  <!-- ═══════════════════════════════════════════════════════════════════════
       Pre-check: Verify prerequisites, set _DdCanUpload flag
       ═══════════════════════════════════════════════════════════════════════ -->
  <Target Name="DatadogCheckCli"
          BeforeTargets="DatadogUploadDsym;DatadogUploadMapping;DatadogUploadPortablePdb;DatadogSymbolReport"
          Condition="'$(DatadogUploadSymbols)' == 'true'">

    <!-- Check if datadog-ci is available (must be installed globally) -->
    <Exec Command="which datadog-ci"
          IgnoreExitCode="true"
          StandardOutputImportance="low"
          StandardErrorImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="_DdCliExitCode" />
    </Exec>

    <Message Importance="high"
             Text="Datadog: Skipping symbol upload — datadog-ci is not installed. Run 'npm install -g @datadog/datadog-ci' to enable."
             Condition="'$(_DdCliExitCode)' != '0'" />

    <Message Importance="high"
             Text="Datadog: Skipping symbol upload — DATADOG_API_KEY is not set. Export it in your shell or pass -p:DatadogApiKey=xxx."
             Condition="'$(_DdCliExitCode)' == '0' AND '$(DatadogApiKey)' == '' AND '$(DATADOG_API_KEY)' == ''" />

    <!-- Only enable upload if both checks pass -->
    <PropertyGroup>
      <_DdHasApiKey Condition="'$(DatadogApiKey)' != '' OR '$(DATADOG_API_KEY)' != ''">true</_DdHasApiKey>
      <_DdHasApiKey Condition="'$(_DdHasApiKey)' == ''">false</_DdHasApiKey>
      <_DdCanUpload Condition="'$(_DdCliExitCode)' == '0' AND '$(_DdHasApiKey)' == 'true'">true</_DdCanUpload>
    </PropertyGroup>

    <!-- Environment overrides for the datadog-ci invocations, shared by the three upload
         targets. Each entry is added only when its property is set; Exec augments the
         inherited environment, so anything exported in the shell otherwise passes
         through. -->
    <PropertyGroup>
      <_DdUploadEnv></_DdUploadEnv>
      <_DdUploadEnv Condition="'$(DatadogApiKey)' != ''">DATADOG_API_KEY=$(DatadogApiKey)</_DdUploadEnv>
      <_DdUploadEnv Condition="'$(DatadogSite)' != '' AND '$(_DdUploadEnv)' != ''">$(_DdUploadEnv);DATADOG_SITE=$(DatadogSite)</_DdUploadEnv>
      <_DdUploadEnv Condition="'$(DatadogSite)' != '' AND '$(_DdUploadEnv)' == ''">DATADOG_SITE=$(DatadogSite)</_DdUploadEnv>
    </PropertyGroup>

    <!-- Site shown in the summary, resolved in datadog-ci's own precedence order. -->
    <PropertyGroup>
      <_DdSiteDisplay Condition="'$(DatadogSite)' != ''">$(DatadogSite) (-p:DatadogSite)</_DdSiteDisplay>
      <_DdSiteDisplay Condition="'$(_DdSiteDisplay)' == '' AND '$(DATADOG_SITE)' != ''">$(DATADOG_SITE) (DATADOG_SITE)</_DdSiteDisplay>
      <_DdSiteDisplay Condition="'$(_DdSiteDisplay)' == '' AND '$(DD_SITE)' != ''">$(DD_SITE) (DD_SITE)</_DdSiteDisplay>
      <_DdSiteDisplay Condition="'$(_DdSiteDisplay)' == ''">datadoghq.com (datadog-ci default)</_DdSiteDisplay>
    </PropertyGroup>
  </Target>

  <!-- ═══════════════════════════════════════════════════════════════════════
       iOS: Upload dSYM after Publish
       ═══════════════════════════════════════════════════════════════════════ -->
  <Target Name="DatadogUploadDsym"
          AfterTargets="Publish"
          Condition="'$(DatadogUploadSymbols)' == 'true' AND $(TargetFramework.Contains('-ios'))">

    <!-- Find the .dSYM bundle — it sits next to the .app, one level above PublishDir -->
    <PropertyGroup>
      <_DdDsymDir>$([System.IO.Path]::GetFullPath('$(PublishDir)../'))</_DdDsymDir>
      <_DdDsymPath>$(_DdDsymDir)$(AssemblyName).app.dSYM</_DdDsymPath>
    </PropertyGroup>

    <Message Importance="high"
             Text="Datadog: Skipping dSYM upload — file not found at $(_DdDsymPath)."
             Condition="'$(_DdCanUpload)' == 'true' AND !Exists('$(_DdDsymPath)')" />

    <Message Importance="high"
             Text="Datadog: Uploading iOS dSYM from $(_DdDsymPath)"
             Condition="'$(_DdCanUpload)' == 'true' AND Exists('$(_DdDsymPath)')" />

    <!-- IgnoreStandardErrorWarningFormat: datadog-ci prints lines such as "⚠️ An error occurred
         while invoking git: Error: …" (no git repository) or "WARN: Error: Could not flush
         metrics …", which Exec would otherwise read as MSBuild errors and report as exit -1,
         even for a successful upload.
         The exit code alone doesn't tell the outcome either: like the other datadog-ci upload
         commands, `dsyms upload` exits 0 when an upload failed or nothing was found (only
         errors that abort the command exit non-zero). Its output is captured and its command
         summary read instead, which prints exactly one of:
           "Uploaded N dSYM(s) in …"                          every dSYM uploaded
           "Some dSYMs have been skipped."                    some dSYMs were skipped
           "Some dSYMS have not been uploaded correctly."     an upload failed after retries
           "No dSYMs detected. …"                             no dSYM found
         A summary that matches none of these is reported as unverified rather than failed. The
         output is checked as one joined text, because file paths in it may contain quotes. -->
    <Exec Command="datadog-ci dsyms upload &quot;$(_DdDsymDir)&quot;"
          Condition="'$(_DdCanUpload)' == 'true' AND Exists('$(_DdDsymPath)')"
          EnvironmentVariables="$(_DdUploadEnv)"
          ConsoleToMSBuild="true"
          IgnoreStandardErrorWarningFormat="true"
          IgnoreExitCode="true"
          ContinueOnError="true">
      <Output TaskParameter="ExitCode" PropertyName="_DdDsymUploadExitCode" />
      <Output TaskParameter="ConsoleOutput" ItemName="_DdDsymUploadOutput" />
    </Exec>

    <PropertyGroup Condition="'$(_DdDsymUploadExitCode)' == '0'">
      <_DdDsymUploadText>@(_DdDsymUploadOutput, ' | ')</_DdDsymUploadText>
      <_DdDsymUploadedCount>$([System.Text.RegularExpressions.Regex]::Match($(_DdDsymUploadText), 'Uploaded (\d+) dSYMs? in').Groups[1].Value)</_DdDsymUploadedCount>

      <_DdDsymUploadProblem Condition="$(_DdDsymUploadText.Contains('No dSYMs detected'))">datadog-ci found no dSYM in $(_DdDsymDir)</_DdDsymUploadProblem>
      <_DdDsymUploadProblem Condition="$(_DdDsymUploadText.Contains('Some dSYMs have been skipped'))">datadog-ci skipped some dSYMs</_DdDsymUploadProblem>
      <_DdDsymUploadProblem Condition="$(_DdDsymUploadText.Contains('Some dSYMS have not been uploaded correctly'))">some dSYM uploads failed</_DdDsymUploadProblem>

      <_DdDsymUploadUnverified Condition="'$(_DdDsymUploadProblem)' == '' AND '$(_DdDsymUploadedCount)' == ''">true</_DdDsymUploadUnverified>
    </PropertyGroup>

    <!-- _DdUploadFailed accumulates across the three upload targets; read by DatadogSymbolReport. -->
    <PropertyGroup>
      <_DdUploadFailed Condition="'$(_DdDsymUploadExitCode)' != '' AND '$(_DdDsymUploadExitCode)' != '0'">true</_DdUploadFailed>
      <_DdUploadFailed Condition="'$(_DdDsymUploadProblem)' != ''">true</_DdUploadFailed>
    </PropertyGroup>
  </Target>

  <!-- ═══════════════════════════════════════════════════════════════════════
       iOS: Strip Portable PDB from the published app bundle
       ═══════════════════════════════════════════════════════════════════════ -->
  <Target Name="DatadogStripPdbFromBundle"
          AfterTargets="_ComputePublishLocation"
          Condition="'$(DatadogUploadSymbols)' == 'true' AND '$(DatadogKeepPortablePdbs)' != 'true' AND $(TargetFramework.Contains('-ios'))">

    <!-- Some iOS debug configurations (e.g. soft-debug, needed to get real IL offsets
         out of Mono's AOT runtime) cause the Portable PDB to be added to
         @(ResolvedFileToPublish) and bundled inside the .app. This SDK always
         symbolicates managed exceptions offline from the PDB uploaded by
         DatadogUploadPortablePdb above, so the on-device copy is never read and
         only adds size — remove it from the bundle unless the customer opted to
         keep it (DatadogKeepPortablePdbs=true). This only removes the file from
         the publish item group, not from disk — the copies DatadogUploadPortablePdb
         picks from (obj/…/linked/, obj/, $(OutputPath)) are untouched. -->
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>

  <!-- ═══════════════════════════════════════════════════════════════════════
       Android: Upload ProGuard/R8 mapping after Publish
       ═══════════════════════════════════════════════════════════════════════ -->
  <Target Name="DatadogUploadMapping"
          AfterTargets="Publish"
          Condition="'$(DatadogUploadSymbols)' == 'true' AND $(TargetFramework.Contains('-android'))">

    <!-- Find the mapping.txt in the build output (generated by R8 when AndroidLinkTool=r8) -->
    <PropertyGroup>
      <_DdMappingPath>$(OutputPath)mapping.txt</_DdMappingPath>
    </PropertyGroup>

    <Message Importance="high"
             Text="Datadog: Skipping mapping upload — mapping.txt not found at $(_DdMappingPath). R8/ProGuard may be disabled."
             Condition="'$(_DdCanUpload)' == 'true' AND !Exists('$(_DdMappingPath)')" />

    <Message Importance="high"
             Text="Datadog: Uploading Android mapping from $(_DdMappingPath)"
             Condition="'$(_DdCanUpload)' == 'true' AND Exists('$(_DdMappingPath)')" />

    <!-- IgnoreStandardErrorWarningFormat and the captured output: see DatadogUploadDsym.
         `flutter-symbols upload` also exits 0 when the upload failed. For the mapping file it
         prints "Mapping upload failed" and its command summary prints exactly one of:
           "Uploaded symbol N file(s) in …"                       the mapping was uploaded
           "Some symbol files have been skipped."                 skipped
           "Some symbol files may not been uploaded correctly."   the upload failed after retries
           "No actions were taken. …"                             nothing was uploaded -->
    <Exec Command="datadog-ci flutter-symbols upload --android-mapping --android-mapping-location &quot;$(_DdMappingPath)&quot; --service-name &quot;$(DatadogServiceName)&quot; --version &quot;$(ApplicationDisplayVersion)&quot;"
          Condition="'$(_DdCanUpload)' == 'true' AND Exists('$(_DdMappingPath)')"
          EnvironmentVariables="$(_DdUploadEnv)"
          ConsoleToMSBuild="true"
          IgnoreStandardErrorWarningFormat="true"
          IgnoreExitCode="true"
          ContinueOnError="true">
      <Output TaskParameter="ExitCode" PropertyName="_DdMappingUploadExitCode" />
      <Output TaskParameter="ConsoleOutput" ItemName="_DdMappingUploadOutput" />
    </Exec>

    <PropertyGroup Condition="'$(_DdMappingUploadExitCode)' == '0'">
      <_DdMappingUploadText>@(_DdMappingUploadOutput, ' | ')</_DdMappingUploadText>
      <_DdMappingUploadedCount>$([System.Text.RegularExpressions.Regex]::Match($(_DdMappingUploadText), 'Uploaded symbol (\d+) files? in').Groups[1].Value)</_DdMappingUploadedCount>

      <_DdMappingUploadProblem Condition="$(_DdMappingUploadText.Contains('No actions were taken'))">datadog-ci uploaded nothing</_DdMappingUploadProblem>
      <_DdMappingUploadProblem Condition="$(_DdMappingUploadText.Contains('Some symbol files have been skipped'))">datadog-ci skipped the mapping</_DdMappingUploadProblem>
      <_DdMappingUploadProblem Condition="$(_DdMappingUploadText.Contains('Mapping upload failed')) OR $(_DdMappingUploadText.Contains('Some symbol files may not been uploaded'))">the mapping upload failed</_DdMappingUploadProblem>

      <_DdMappingUploadUnverified Condition="'$(_DdMappingUploadProblem)' == '' AND '$(_DdMappingUploadedCount)' == ''">true</_DdMappingUploadUnverified>
    </PropertyGroup>

    <PropertyGroup>
      <_DdUploadFailed Condition="'$(_DdMappingUploadExitCode)' != '' AND '$(_DdMappingUploadExitCode)' != '0'">true</_DdUploadFailed>
      <_DdUploadFailed Condition="'$(_DdMappingUploadProblem)' != ''">true</_DdUploadFailed>
    </PropertyGroup>
  </Target>

  <!-- ═══════════════════════════════════════════════════════════════════════
       Portable PDB: Upload first-party Portable PDB after Publish
       ═══════════════════════════════════════════════════════════════════════ -->
  <Target Name="DatadogUploadPortablePdb"
          AfterTargets="Publish"
          DependsOnTargets="_DdComputeLinkedDirectories"
          Condition="'$(DatadogUploadSymbols)' == 'true' AND ($(TargetFramework.Contains('-ios')) Or $(TargetFramework.Contains('-android')))">

    <!-- Uploads, for the app's assemblies, the Portable PDB that matches the assembly the
         app actually ships, so Datadog can symbolicate managed (C#) exceptions.

         Which assemblies: the ones whose PDB lands in $(OutputPath) (bin/…), outside the .app
         bundle — the app's own, its project references, and any package PDBs copied there
         (e.g. CopyDebugSymbolFilesFromPackages) — the same set the previous whole-bin/ upload
         sent. Which file: not necessarily the bin/ copy.
         On iOS device builds the managed static registrar (run inside the linker) rewrites
         the app's assembly, which shifts its MethodDef tokens and gives it a new CodeView
         GUID; the linker writes the matching PDB under obj/…/linked/, while bin/ keeps the
         compiler's PDB for the pre-link assembly. datadog-ci pairs a PDB with a manifest id
         by file name only, so uploading bin/ there made every frame resolve one method off
         (RUM-18989). The DebugIdManifestGenerator tool's staging mode instead copies, per
         manifest entry, the candidate whose PDB GUID matches the manifest's (GUID only — IL
         stripping re-stamps shipped assemblies) into a staging directory, and only that
         directory is uploaded. Candidates are listed most-likely-first: linker output, then
         the compiler output in obj/, then bin/ (including anything bundled in the .app).

         $(_DdDebugIdManifestPath) is usually already set by Datadog.Maui.DebugId.targets
         (imported above). It's recomputed here as a fallback for split build/publish
         invocations (e.g. a `dotnet build` followed by a no-build `dotnet publish`), where the
         publish step runs in a fresh MSBuild process and the DebugId targets never re-run —
         this keeps the target self-sufficient in that case. -->
    <PropertyGroup>
      <_DdDebugIdManifestPath Condition="'$(_DdDebugIdManifestPath)' == ''">$(IntermediateOutputPath)dd_debug_ids.json</_DdDebugIdManifestPath>
      <!-- No trailing separator: it's passed quoted on the command line, where a trailing
           backslash would escape the closing quote on Windows. -->
      <_DdPpdbStagingDir>$(IntermediateOutputPath)dd_ppdb_upload</_DdPpdbStagingDir>
      <_DdPpdbCandidatesFile>$(IntermediateOutputPath)dd_ppdb_candidates.rsp</_DdPpdbCandidatesFile>
      <_DdPpdbOutputPdbsFile>$(IntermediateOutputPath)dd_ppdb_output_pdbs.rsp</_DdPpdbOutputPdbsFile>
    </PropertyGroup>

    <ItemGroup>
      <!-- The PDBs in the build output decide WHICH assemblies get uploaded, so leave out
           anything bundled inside the .app: with DatadogKeepPortablePdbs=true, soft-debug
           builds bundle framework PDBs there too (e.g. Microsoft.iOS.pdb, ~21 MB). Bundled
           PDBs still count as candidate files for assemblies that are on the list. -->
      <_DdPpdbInOutput Include="$(OutputPath)**\*.pdb" Exclude="$(OutputPath)**\*.app\**" />
      <_DdPpdbBundled Include="$(OutputPath)**\*.app\**\*.pdb" />
      <!-- Linker output of the RIDs this build targets (see _DdComputeLinkedDirectories in
           Datadog.Maui.DebugId.targets). -->
      <_DdPpdbCandidate Include="$(_DdLinkedPdbGlobs)" />
      <_DdPpdbCandidate Include="$(IntermediateOutputPath)*.pdb" />
      <_DdPpdbCandidate Include="@(_DdPpdbInOutput);@(_DdPpdbBundled)" />
    </ItemGroup>

    <!-- Empty the staging directory up front, so PDBs staged by an earlier build can't be
         left behind when staging is skipped or fails this time (the tool also empties it,
         but only once it gets that far). -->
    <ItemGroup>
      <_DdPpdbPreviouslyStaged Include="$(_DdPpdbStagingDir)\*.pdb" />
    </ItemGroup>
    <Delete Files="@(_DdPpdbPreviouslyStaged)" ContinueOnError="true" />

    <Message Importance="high"
             Text="Datadog: Skipping Portable PDB upload — no debug-id manifest found at $(_DdDebugIdManifestPath)."
             Condition="'$(_DdCanUpload)' == 'true' AND !Exists('$(_DdDebugIdManifestPath)')" />

    <Message Importance="high"
             Text="Datadog: Skipping Portable PDB upload — no Portable PDB found in $(OutputPath)."
             Condition="'$(_DdCanUpload)' == 'true' AND Exists('$(_DdDebugIdManifestPath)') AND '@(_DdPpdbInOutput)' == ''" />

    <PropertyGroup>
      <_DdPpdbSkipReason Condition="'$(_DdCanUpload)' == 'true' AND !Exists('$(_DdDebugIdManifestPath)')">no debug-id manifest</_DdPpdbSkipReason>
      <_DdPpdbSkipReason Condition="'$(_DdCanUpload)' == 'true' AND Exists('$(_DdDebugIdManifestPath)') AND '@(_DdPpdbInOutput)' == ''">no Portable PDB in the build output</_DdPpdbSkipReason>
    </PropertyGroup>

    <PropertyGroup>
      <_DdPpdbCanStage Condition="'$(_DdCanUpload)' == 'true' AND Exists('$(_DdDebugIdManifestPath)') AND '@(_DdPpdbInOutput)' != ''">true</_DdPpdbCanStage>
    </PropertyGroup>

    <WriteLinesToFile File="$(_DdPpdbCandidatesFile)" Lines="@(_DdPpdbCandidate->'%(FullPath)')" Overwrite="true" Condition="'$(_DdPpdbCanStage)' == 'true'" />
    <WriteLinesToFile File="$(_DdPpdbOutputPdbsFile)" Lines="@(_DdPpdbInOutput->'%(FullPath)')" Overwrite="true" Condition="'$(_DdPpdbCanStage)' == 'true'" />

    <Exec Command="dotnet exec &quot;$(_DdDebugIdManifestGeneratorDll)&quot; --stage-pdbs &quot;$(_DdDebugIdManifestPath)&quot; &quot;$(_DdPpdbStagingDir)&quot; &quot;@$(_DdPpdbCandidatesFile)&quot; &quot;@$(_DdPpdbOutputPdbsFile)&quot;"
          Condition="'$(_DdPpdbCanStage)' == 'true'"
          IgnoreExitCode="true"
          ContinueOnError="true">
      <Output TaskParameter="ExitCode" PropertyName="_DdPpdbStageExitCode" />
    </Exec>

    <!-- Staging exit codes (see the tool's Program.cs): 0 = all good; 2 = staged, but some
         assembly had candidate PDBs and none matched what the app ships (reported as a
         warning by DatadogSymbolReport); anything else = staging failed. -->
    <PropertyGroup>
      <_DdPpdbStageOk Condition="'$(_DdPpdbStageExitCode)' == '0' OR '$(_DdPpdbStageExitCode)' == '2'">true</_DdPpdbStageOk>
      <_DdPpdbUnmatched Condition="'$(_DdPpdbStageExitCode)' == '2'">true</_DdPpdbUnmatched>
      <_DdPpdbStageFailed Condition="'$(_DdPpdbStageExitCode)' != '' AND '$(_DdPpdbStageOk)' != 'true'">true</_DdPpdbStageFailed>
    </PropertyGroup>

    <ItemGroup Condition="'$(_DdPpdbStageOk)' == 'true'">
      <_DdPpdbStaged Include="$(_DdPpdbStagingDir)\*.pdb" />
    </ItemGroup>

    <Message Importance="high"
             Text="Datadog: Skipping Portable PDB upload — no Portable PDB matches the debug id of an assembly the app ships (see the lines above)."
             Condition="'$(_DdPpdbStageOk)' == 'true' AND '@(_DdPpdbStaged)' == ''" />

    <PropertyGroup>
      <_DdPpdbSkipReason Condition="'$(_DdPpdbStageOk)' == 'true' AND '@(_DdPpdbStaged)' == ''">no matching Portable PDB</_DdPpdbSkipReason>
    </PropertyGroup>

    <Message Importance="high"
             Text="Datadog: Uploading Portable PDB(s) staged in $(_DdPpdbStagingDir)"
             Condition="'@(_DdPpdbStaged)' != ''" />

    <!-- datadog-ci searches the folder with a glob pattern (<folder>/**/*.pdb), where a
         backslash escapes the next character instead of separating path segments, so a
         Windows path like obj\Release\…\dd_ppdb_upload matches no file and the upload
         silently does nothing (dd-sdk-maui#97). Forward slashes work on every platform:
         Windows accepts them in paths, and on macOS/Linux Exec already turns backslashes
         into forward slashes. Only this argument is a glob; the manifest is opened as a
         plain file. -->
    <PropertyGroup>
      <_DdPpdbUploadDir>$(_DdPpdbStagingDir.Replace('\', '/'))</_DdPpdbUploadDir>
    </PropertyGroup>

    <!-- ppdb-symbols upload has no service-name/version options (unlike flutter-symbols
         upload) — the debug-id manifest is the sole correlation key for these uploads.
         IgnoreStandardErrorWarningFormat and the captured output: see DatadogUploadDsym. -->
    <Exec Command="datadog-ci ppdb-symbols upload &quot;$(_DdPpdbUploadDir)&quot; --debug-id-manifest &quot;$(_DdDebugIdManifestPath)&quot;"
          Condition="'@(_DdPpdbStaged)' != ''"
          EnvironmentVariables="$(_DdUploadEnv)"
          ConsoleToMSBuild="true"
          IgnoreStandardErrorWarningFormat="true"
          IgnoreExitCode="true"
          ContinueOnError="true">
      <Output TaskParameter="ExitCode" PropertyName="_DdPpdbUploadExitCode" />
      <Output TaskParameter="ConsoleOutput" ItemName="_DdPpdbUploadOutput" />
    </Exec>

    <!-- datadog-ci exits 0 even when it found no file, skipped files or failed to upload
         some (only errors that abort the command exit non-zero: an invalid API key, invalid
         arguments, a missing or unreadable folder, a missing or invalid manifest), so the
         exit code alone can't tell an upload happened. Its command summary prints exactly one of:
           "Uploaded symbol N file(s) in …"        every file uploaded
           "Some symbol files have been skipped."  a file had no (or an ambiguous) manifest entry
           "Some symbol files may not been uploaded correctly."  an upload failed after retries
           "No actions were taken. …"             no file found
         The upload counts as done only when every staged PDB was uploaded. A summary that
         matches none of these (e.g. reworded by a later datadog-ci) is reported as
         unverified rather than failed. The output is checked as one joined text, not line by
         line in item conditions, because file paths in it may contain quotes. -->
    <PropertyGroup Condition="'$(_DdPpdbUploadExitCode)' == '0'">
      <_DdPpdbUploadText>@(_DdPpdbUploadOutput, ' | ')</_DdPpdbUploadText>
      <_DdPpdbStagedCount>@(_DdPpdbStaged->Count())</_DdPpdbStagedCount>
      <_DdPpdbUploadedCount>$([System.Text.RegularExpressions.Regex]::Match($(_DdPpdbUploadText), 'Uploaded symbol (\d+) files? in').Groups[1].Value)</_DdPpdbUploadedCount>

      <_DdPpdbUploadProblem Condition="$(_DdPpdbUploadText.Contains('No actions were taken'))">datadog-ci found none of the $(_DdPpdbStagedCount) staged Portable PDB(s) in $(_DdPpdbUploadDir) (path not matched)</_DdPpdbUploadProblem>
      <_DdPpdbUploadProblem Condition="$(_DdPpdbUploadText.Contains('Some symbol files have been skipped'))">datadog-ci skipped some Portable PDBs</_DdPpdbUploadProblem>
      <_DdPpdbUploadProblem Condition="$(_DdPpdbUploadText.Contains('Some symbol files may not been uploaded'))">some Portable PDB uploads failed</_DdPpdbUploadProblem>
      <_DdPpdbUploadProblem Condition="'$(_DdPpdbUploadProblem)' == '' AND '$(_DdPpdbUploadedCount)' != '' AND '$(_DdPpdbUploadedCount)' != '$(_DdPpdbStagedCount)'">datadog-ci uploaded $(_DdPpdbUploadedCount) of $(_DdPpdbStagedCount) staged Portable PDBs</_DdPpdbUploadProblem>

      <_DdPpdbUploadUnverified Condition="'$(_DdPpdbUploadProblem)' == '' AND '$(_DdPpdbUploadedCount)' == ''">true</_DdPpdbUploadUnverified>
    </PropertyGroup>

    <PropertyGroup>
      <_DdUploadFailed Condition="'$(_DdPpdbStageFailed)' == 'true'">true</_DdUploadFailed>
      <_DdUploadFailed Condition="'$(_DdPpdbUploadExitCode)' != '' AND '$(_DdPpdbUploadExitCode)' != '0'">true</_DdUploadFailed>
      <_DdUploadFailed Condition="'$(_DdPpdbUploadProblem)' != ''">true</_DdUploadFailed>
    </PropertyGroup>
  </Target>

  <!-- ═══════════════════════════════════════════════════════════════════════
       Summary: Report what was uploaded (always runs when enabled)
       ═══════════════════════════════════════════════════════════════════════ -->
  <!-- Anchored on "Publish" itself, NOT on DatadogUploadDsym/Mapping/PortablePdb — those
       three are themselves only reached via their own AfterTargets="Publish" hooks, so
       they never sit at a stable, later point in the build graph for another target to
       hook onto (the same "AfterTargets targets a NAME, not a real completion point"
       gotcha documented in Datadog.Maui.DebugId.targets). Anchoring on "Publish" — a
       real, always-present target — and relying on MSBuild's stable declaration-order
       scheduling among sibling AfterTargets="Publish" hooks (this target is declared
       last in the file, after the three upload targets) reliably runs this last.
       Note: this declaration-order behavior is empirically stable across current
       MSBuild versions but is not an explicitly documented public contract — if a
       future MSBuild version changes it, add an explicit DependsOnTargets fallback. -->
  <Target Name="DatadogSymbolReport"
          AfterTargets="Publish"
          Condition="'$(DatadogUploadSymbols)' == 'true'">

    <!-- Per-upload outcome, from each Exec's captured exit code. Empty means the upload
         was skipped (wrong platform, missing artifact, or upload disabled). -->
    <PropertyGroup>
      <_DdDsymStatus Condition="'$(_DdDsymUploadExitCode)' == ''">not run</_DdDsymStatus>
      <_DdDsymStatus Condition="'$(_DdDsymUploadExitCode)' == '0'">uploaded ($(_DdDsymUploadedCount) dSYM(s))</_DdDsymStatus>
      <_DdDsymStatus Condition="'$(_DdDsymUploadUnverified)' == 'true'">upload not verified (datadog-ci summary not recognized; build with -v:n to see its output)</_DdDsymStatus>
      <_DdDsymStatus Condition="'$(_DdDsymUploadProblem)' != ''">FAILED ($(_DdDsymUploadProblem))</_DdDsymStatus>
      <_DdDsymStatus Condition="'$(_DdDsymUploadExitCode)' != '' AND '$(_DdDsymUploadExitCode)' != '0'">FAILED (exit $(_DdDsymUploadExitCode))</_DdDsymStatus>

      <_DdMappingStatus Condition="'$(_DdMappingUploadExitCode)' == ''">not run</_DdMappingStatus>
      <_DdMappingStatus Condition="'$(_DdMappingUploadExitCode)' == '0'">uploaded</_DdMappingStatus>
      <_DdMappingStatus Condition="'$(_DdMappingUploadUnverified)' == 'true'">upload not verified (datadog-ci summary not recognized; build with -v:n to see its output)</_DdMappingStatus>
      <_DdMappingStatus Condition="'$(_DdMappingUploadProblem)' != ''">FAILED ($(_DdMappingUploadProblem))</_DdMappingStatus>
      <_DdMappingStatus Condition="'$(_DdMappingUploadExitCode)' != '' AND '$(_DdMappingUploadExitCode)' != '0'">FAILED (exit $(_DdMappingUploadExitCode))</_DdMappingStatus>

      <_DdPpdbStatus Condition="'$(_DdPpdbUploadExitCode)' == ''">not run</_DdPpdbStatus>
      <_DdPpdbStatus Condition="'$(_DdPpdbUploadExitCode)' == '' AND '$(_DdPpdbSkipReason)' != ''">skipped ($(_DdPpdbSkipReason))</_DdPpdbStatus>
      <_DdPpdbStatus Condition="'$(_DdPpdbUploadExitCode)' == '0'">uploaded ($(_DdPpdbUploadedCount) of $(_DdPpdbStagedCount))</_DdPpdbStatus>
      <_DdPpdbStatus Condition="'$(_DdPpdbUploadUnverified)' == 'true'">upload not verified (datadog-ci summary not recognized; build with -v:n to see its output)</_DdPpdbStatus>
      <_DdPpdbStatus Condition="'$(_DdPpdbUploadProblem)' != ''">FAILED ($(_DdPpdbUploadProblem))</_DdPpdbStatus>
      <_DdPpdbStatus Condition="'$(_DdPpdbUploadExitCode)' != '' AND '$(_DdPpdbUploadExitCode)' != '0'">FAILED (exit $(_DdPpdbUploadExitCode))</_DdPpdbStatus>
      <_DdPpdbStatus Condition="'$(_DdPpdbStageFailed)' == 'true'">FAILED (staging, exit $(_DdPpdbStageExitCode))</_DdPpdbStatus>
      <_DdPpdbStatus Condition="'$(_DdPpdbUnmatched)' == 'true'">$(_DdPpdbStatus); some assemblies had no matching Portable PDB</_DdPpdbStatus>
    </PropertyGroup>

    <Message Importance="high" Text="" />
    <Message Importance="high" Text="╔══════════════════════════════════════════════════╗" />
    <Message Importance="high" Text="║  Datadog Symbol Upload Summary                   ║" />
    <Message Importance="high" Text="╚══════════════════════════════════════════════════╝" />
    <Message Importance="high" Text="  Service:  $(DatadogServiceName)" />
    <Message Importance="high" Text="  Version:  $(ApplicationDisplayVersion)" />
    <Message Importance="high" Text="  Site:     $(_DdSiteDisplay)" />
    <Message Importance="high" Text="  Enabled:  $(_DdCanUpload)" />
    <Message Importance="high"
             Text="  iOS dSYM: $(_DdDsymStatus) — $(_DdDsymPath)"
             Condition="$(TargetFramework.Contains('-ios'))" />
    <Message Importance="high"
             Text="  iOS bundled Portable PDB: $(DatadogKeepPortablePdbs)"
             Condition="$(TargetFramework.Contains('-ios'))" />
    <Message Importance="high"
             Text="  Android mapping: $(_DdMappingStatus) — $(OutputPath)mapping.txt"
             Condition="$(TargetFramework.Contains('-android'))" />
    <Message Importance="high"
             Text="  Portable PDB: $(_DdPpdbStatus) — $(_DdPpdbStagingDir) (manifest: $(_DdDebugIdManifestPath))"
             Condition="$(TargetFramework.Contains('-ios')) Or $(TargetFramework.Contains('-android'))" />
    <Message Importance="high" Text="" />

    <Warning Condition="'$(_DdUploadFailed)' == 'true' AND '$(DatadogFailOnSymbolUploadError)' != 'true'"
             Text="Datadog: one or more symbol uploads FAILED (see the summary above). Crashes from this build will not symbolicate. Check the Datadog lines above; for upload errors, check DATADOG_API_KEY is valid for site $(_DdSiteDisplay). Pass -p:DatadogFailOnSymbolUploadError=true to turn this into a build error." />

    <!-- Not a failure (the uploads may well have worked), so it stays a warning even with
         DatadogFailOnSymbolUploadError=true; it only makes the unconfirmed uploads visible. -->
    <ItemGroup>
      <_DdUnverifiedUpload Include="iOS dSYM" Condition="'$(_DdDsymUploadUnverified)' == 'true'" />
      <_DdUnverifiedUpload Include="Android mapping" Condition="'$(_DdMappingUploadUnverified)' == 'true'" />
      <_DdUnverifiedUpload Include="Portable PDB" Condition="'$(_DdPpdbUploadUnverified)' == 'true'" />
    </ItemGroup>
    <Warning Condition="'@(_DdUnverifiedUpload)' != ''"
             Text="Datadog: could not confirm these symbol uploads: @(_DdUnverifiedUpload, ', '). datadog-ci's command summary was not recognized (build with -v:n to see its output). Crashes from this build may not symbolicate if an upload did not happen." />

    <Warning Condition="'$(_DdPpdbUnmatched)' == 'true' AND '$(DatadogFailOnSymbolUploadError)' != 'true'"
             Text="Datadog: no Portable PDB matching the shipped assembly was found for one or more assemblies (see the 'not uploading a Portable PDB' lines above). C# frames from those assemblies will not symbolicate. Pass -p:DatadogFailOnSymbolUploadError=true to turn this into a build error." />

    <Error Condition="'$(_DdUploadFailed)' == 'true' AND '$(DatadogFailOnSymbolUploadError)' == 'true'"
           Text="Datadog: one or more symbol uploads FAILED (see the summary above). Crashes from this build will not symbolicate. Check the Datadog lines above; for upload errors, check DATADOG_API_KEY is valid for site $(_DdSiteDisplay)." />

    <Error Condition="'$(_DdPpdbUnmatched)' == 'true' AND '$(DatadogFailOnSymbolUploadError)' == 'true'"
           Text="Datadog: no Portable PDB matching the shipped assembly was found for one or more assemblies (see the 'not uploading a Portable PDB' lines above). C# frames from those assemblies will not symbolicate." />
  </Target>

</Project>
