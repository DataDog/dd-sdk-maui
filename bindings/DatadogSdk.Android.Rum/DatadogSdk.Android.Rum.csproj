<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net9.0-android;net10.0-android</TargetFrameworks>
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AndroidClassParser>class-parse</AndroidClassParser>
    <!-- Suppress XA4241/XA4242: Java transitive deps are satisfied via NuGet; verification not needed -->
    <NoWarn>$(NoWarn);XA4241;XA4242</NoWarn>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- dd-sdk-android-rum from Maven Central -->
    <AndroidMavenLibrary Include="com.datadoghq:dd-sdk-android-rum" Version="3.8.0" VerifyDependencies="false" />

    <!-- Runtime transitive dependency required by RUM (slow frames / JankStats) -->
    <AndroidMavenLibrary Include="androidx.metrics:metrics-performance" Version="1.0.0-beta03" VerifyDependencies="false" Bind="false" Repository="Google" />

    <!-- NDK crash reporting (called when nativeCrashReportEnabled = true) -->
    <AndroidMavenLibrary Include="com.datadoghq:dd-sdk-android-ndk" Version="3.8.0" VerifyDependencies="false" Bind="false" />

    <!-- Metadata transformations -->
    <TransformFile Include="Transforms\Metadata.xml" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reference core binding project (which includes internal) -->
    <ProjectReference Include="..\DatadogSdk.Android.Core\DatadogSdk.Android.Core.csproj" />

    <!-- Required for Kotlin-based libraries -->
    <PackageReference Include="Xamarin.Kotlin.StdLib" Version="2.2.0.1" />
  </ItemGroup>
</Project>
