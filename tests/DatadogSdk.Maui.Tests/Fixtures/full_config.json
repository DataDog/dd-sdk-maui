{
  "ClientToken": "pub-test-full-config",
  "Environment": "staging",
  "Site": "Eu1",
  "Service": "my-maui-app",
  "TrackingConsent": "Pending",
  "Verbosity": "DEBUG",
  "BatchSize": "Large",
  "UploadFrequency": "Frequent",
  "BatchProcessingLevel": "High",
  "Version": "2.1.0",
  "VersionSuffix": "-rc1",
  "FirstPartyHosts": [
    { "Match": "api.example.com", "HeaderTypes": ["Datadog", "TraceContext"] },
    { "Match": "cdn.example.com", "HeaderTypes": ["B3"] }
  ],
  "NativeCrashReportEnabled": true,
  "AdditionalConfiguration": {
    "_dd.needsClearTextHttp": true,
    "_dd.custom_key": "custom_value"
  },
  "ProxyConfiguration": {
    "Type": "Http",
    "Address": "proxy.example.com",
    "Port": 8080,
    "Username": "user",
    "Password": "pass"
  }
}
